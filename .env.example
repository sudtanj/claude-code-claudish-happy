# Copy this file to .env and fill in what you need, then reference it from
# docker-compose.yml (already wired up via `env_file: .env`).
#
# You don't need every variable below - only the ones for the CLI/provider
# combination you actually run (see README.md for the full breakdown).

# --- Claude Code (`claude`) / Happy with Codex disabled (`happy claude`) ---
# Required to run `claude` directly, or `happy claude`.
ANTHROPIC_API_KEY=

# --- Claudish (`claudish`) - run Claude Code against any model -------------
# Also used by `claudish-happy`, which runs the same proxy but hands the
# resulting Claude Code session to Happy for mobile/web control.
# Provide at least ONE of these, matching the --model provider you pass to
# claudish (e.g. --model openrouter@... needs OPENROUTER_API_KEY).
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# For a local Ollama instead of a hosted provider, point at it instead of
# supplying a key (e.g. http://host.docker.internal:11434):
OLLAMA_HOST=

# --- Happy with Codex (`happy codex`) ---------------------------------------
# Required to run `happy codex` (uses your OpenAI account).
# OPENAI_API_KEY=

# --- Optional -----------------------------------------------------------
# Fixed local port for the claudish proxy (default: random 3000-9000).
CLAUDISH_PORT=
