# Copy this file to .env and fill in what you need, then reference it from
# docker-compose.yml (already wired up via `env_file: .env`).
#
# You don't need every variable below - only the ones for the CLI/provider
# combination you actually run (see README.md for the full breakdown).

# --- Claude Code (`claude`) / Happy with Codex disabled (`happy claude`) ---
# Required to run `claude` directly, or `happy claude`.
ANTHROPIC_API_KEY=

# --- Claudish (`claudish`) - run Claude Code against any model -------------
# Also used by `claudish-happy`, which runs the same proxy but hands the
# resulting Claude Code session to Happy for mobile/web control.
# Provide at least ONE of these, matching the --model provider you pass to
# claudish (e.g. --model openrouter@... needs OPENROUTER_API_KEY).
OPENROUTER_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# For a local Ollama instead of a hosted provider, point at it instead of
# supplying a key (e.g. http://host.docker.internal:11434):
OLLAMA_HOST=

# Custom OpenAI-compatible / Anthropic-compatible endpoints (e.g. your own
# gateway, vLLM/LM Studio box, or a self-hosted Claude-compatible proxy).
# Each is independent and optional; set the URL to register it, and the
# matching *_API_KEY only if the endpoint requires auth (omitted -> no auth
# header is sent). Registered as Claudish "customEndpoints" named
# custom-openai / custom-anthropic - use with e.g.:
#   claudish --model custom-openai@<model-name>
#   claudish --model custom-anthropic@<model-name>
CUSTOM_OPENAI_BASE_URL=
CUSTOM_OPENAI_API_KEY=
CUSTOM_ANTHROPIC_BASE_URL=
CUSTOM_ANTHROPIC_API_KEY=

# --- Happy with Codex (`happy codex`) ---------------------------------------
# Required to run `happy codex` (uses your OpenAI account).
# OPENAI_API_KEY=

# --- Happy pairing (`happy claude` / `happy codex` / `claudish-happy`) -----
# No env var is required here - Happy pairs your phone/browser via a QR
# code / link it prints on first run (see README.md), and saves credentials
# under HAPPY_HOME_DIR for later runs. Only set these if you're self-hosting
# Happy's own server instead of the hosted api.cluster-fluster.com one:
# HAPPY_SERVER_URL=
# HAPPY_WEBAPP_URL=
# HAPPY_HOME_DIR=

# --- Optional -----------------------------------------------------------
# Fixed local port for the claudish proxy (default: random 3000-9000).
CLAUDISH_PORT=
